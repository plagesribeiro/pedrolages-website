# Copie pra `.env` (gitignored) e preencha. Em produção, configure os mesmos
# nomes em: Cloudflare Pages → Settings → Environment Variables.
#
# Nada aqui começa com `PUBLIC_`, então SvelteKit mantém todos esses valores
# *apenas no servidor* (Cloudflare Worker). O navegador nunca os recebe.

# JSON completo da service account, codificado em base64.
# Gerar: base64 -i path/to/key.json | tr -d '\n' | pbcopy
GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY=

# ID da pasta raiz no Drive (último pedaço da URL drive.google.com/drive/folders/...).
GOOGLE_DRIVE_ROOT_FOLDER_ID=
